# ── Waddle Frontend — Environment Variables ───────────────────────────────────
# Copy to `.env` for local development. ONLY non-secret, browser-safe values
# belong here — anything prefixed with VITE_ is bundled into the public build.
# NEVER put API keys or secrets in this file.

# Base URL of the Waddle backend (Express server on Railway / Render / Fly.io).
# - Local dev: leave EMPTY to use the Vite dev proxy (see vite.config.js), which
#   forwards /api requests to http://localhost:3001 with no CORS hassle.
# - Production (Vercel): set this to your deployed backend URL, e.g.
#       VITE_API_BASE_URL=https://waddle-backend.up.railway.app
VITE_API_BASE_URL=
