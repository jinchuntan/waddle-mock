# ── Waddle Backend — Environment Variables ────────────────────────────────────
# Copy to `.env` for local development. These are SERVER-SIDE secrets — they must
# NEVER be exposed to the browser or committed to version control.
# On Railway / Render / Fly.io, set these in the platform's environment settings.

# ── Server ────────────────────────────────────────────────────────────────────
# PORT is usually injected by the host (Railway/Render/Fly). Defaults to 3001.
PORT=3001
NODE_ENV=development

# ── Database — hosted PostgreSQL (Railway Postgres / Supabase / Neon) ──────────
# Managed providers (Supabase, Neon) usually require SSL — append ?sslmode=require
# e.g. postgresql://user:pass@host:5432/waddle?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/waddle

# ── Public URLs (used for CORS + Google OAuth redirects) ──────────────────────
# BACKEND_URL  = where this server is reachable (used to build the OAuth callback)
# FRONTEND_URL = the Vercel site; CORS only allows requests from this origin
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ── Secrets (generate long random strings, e.g. `openssl rand -hex 32`) ───────
SESSION_SECRET=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-long-random-string

# ── Google OAuth (console.cloud.google.com → Credentials → OAuth client) ──────
# Authorised redirect URI must be: <BACKEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / SMTP (supplier inquiry emails) ────────────────────────────────────
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=you@example.com
EMAIL_PASS=your-smtp-or-app-password
EMAIL_FROM_NAME=Waddle Procurement

# ── OpenRouter (AI — OpenAI-compatible API) ───────────────────────────────────
# Get a key at https://openrouter.ai/keys. All AI calls run server-side.
OPENROUTER_API_KEY=
# Main model — quality generation (negotiation replies, emails, search)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Small model — cheap classification / extraction (supplier intent detection)
OPENROUTER_SMALL_MODEL=anthropic/claude-3.5-haiku
# Optional attribution shown on the OpenRouter dashboard
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Waddle
